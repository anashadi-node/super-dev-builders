# Secrets — JANGAN pernah masuk git
.env
.env.*
!.env.template
!.env.example
*.env
*.pem
*.key

# Kredensial perkakas (gh CLI, git credential store, ssh)
hosts.yml
.git-credentials
.netrc
id_rsa*
id_ed25519*

# Python
__pycache__/
*.pyc
.pytest_cache/

# Bukti run Super Dev Builders — memuat PETA identitas pelanggan pilot.
# Jangan pernah masuk git: isinya memetakan token identitas ↔ berkas asal.
evidence/rt-rw-portal/identity-scan.json
.venv/

# Artefak lingkungan sementara (uv run --with)
uv.lock

# Evidence MENTAH sebelum redaksi (wajib diredaksi dulu) — berlaku SEMUA tree
**/*.raw
evidence/**/*.raw
*.har

# Data besar / hasil sementara
data/raw/
*.log.tmp

# Workspace uji E2E / self-test (dibuat `sdb init` saat uji) — jangan ikut commit
evidence/e2e-*/
normalized/e2e-*/
reconstruction/e2e-*/
verification/e2e-*/
reports/e2e-*/
runs/e2e-*/
targets/e2e-*/
**/_selftest*/
**/zz-*/

# SDB deck runtime state
dashboard/state/

# salinan audit (regenerable via git archive) — jangan di-commit
runs/rt-rw-portal/ulang2-clean/

# Keluaran pindai rahasia (regenerable via `make secrets` / `make secrets-raw`)
state/gitleaks-raw.json
state/gitleaks-nofilter.toml

# artefak kerja — diarsipkan ke luar git (ADR-0002), jangan dilacak lagi.
# Pola /* dipakai (bukan /) supaya pengecualian INDEX.md tetap berlaku.
/runs/*
!/runs/INDEX.md
/evidence/*
!/evidence/INDEX.md
/verification/*
!/verification/INDEX.md
/normalized/*
!/normalized/INDEX.md
